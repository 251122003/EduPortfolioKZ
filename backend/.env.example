# Copy to backend/.env and fill in. Never commit .env.
PORT=3000
APP_BASE_URL=http://localhost:5173
DATABASE_URL="postgresql://eduportfolio:change_me@localhost:5432/eduportfolio?schema=public"

# 32 random bytes as 64 hex characters each, different from each other:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IIN_HMAC_KEY=
IIN_ENCRYPTION_KEY=

# Signs session tokens (HS256). Required: the app does not start without it.
# At least 32 characters; generate 32 random bytes with the same command as above.
JWT_SECRET=
SMS_PROVIDER=mock
# Course demo only: lets SMS_PROVIDER=mock start with NODE_ENV=production (codes go to the server log).
# Never true for real users. See docs/deployment.md.
SMS_MOCK_ALLOWED_IN_PRODUCTION=false
SMS_API_KEY=

# Optional: folder with the built frontend (index.html). Default: dist/ in the repository root.
STATIC_DIR=

# Password for the demo accounts created by `npx prisma db seed` (default: Demo-Password-2026).
# Leave commented out locally; for any shared database set a strong one. Never commit it.
# SEED_PASSWORD=
LLM_API_KEY=
LLM_MODEL=
