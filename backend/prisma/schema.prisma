// EduPortfolio KZ - database schema
// Source of truth for tables, columns and relations. See docs/database-schema.md.
//
// Rules that Prisma cannot express (CHECK constraints, partial indexes, triggers)
// are added by hand to the first migration: prisma/migrations/<timestamp>_init/migration.sql.
// The database connection string lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  student
  organization
  admin

  @@map("user_role")
}

enum Locale {
  kk
  ru

  @@map("locale")
}

enum OrgStatus {
  pending
  verified
  rejected
  suspended

  @@map("org_status")
}

enum StudentStatus {
  unclaimed
  claimed

  @@map("student_status")
}

enum EventLevel {
  school
  district
  regional
  national
  international

  @@map("event_level")
}

enum AwardType {
  diploma
  certificate

  @@map("award_type")
}

enum AwardStatus {
  active
  corrected
  revoked

  @@map("award_status")
}

enum ChangeRequestType {
  change_iin
  revoke
  merge_duplicates

  @@map("change_request_type")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected

  @@map("change_request_status")
}

enum OtpStatus {
  issued
  verified
  expired
  locked

  @@map("otp_status")
}

enum AiFlagStatus {
  open
  confirmed
  dismissed

  @@map("ai_flag_status")
}

enum AiJobStatus {
  queued
  running
  done
  failed

  @@map("ai_job_status")
}

// ---------- Identity ----------

// All primary keys use uuidv7() (built into PostgreSQL 18): time-ordered UUIDs,
// so new rows go to the end of the B-tree index instead of random pages.

model Organization {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @db.VarChar(255)
  bin       String    @unique @db.Char(12)
  type      String    @db.VarChar(50)
  status    OrgStatus @default(pending)
  contact   String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users  User[]
  events Event[]

  @@map("organizations")
}

// login is used only by organization staff and admins (email).
// Students sign in with their phone: lookup by students.phone_hash, never a plain phone number.
model User {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  role           UserRole
  login          String?  @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  locale         Locale   @default(ru)
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student         Student?
  awardsCreated   Award[]         @relation("AwardCreatedBy")
  changeRequested ChangeRequest[] @relation("ChangeRequestedBy")
  changeReviewed  ChangeRequest[] @relation("ChangeReviewedBy")
  aiFlagsReviewed AiFlag[]        @relation("AiFlagReviewedBy")
  auditEntries    AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Student {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String?       @unique @map("user_id") @db.Uuid
  iinHash           String        @unique @map("iin_hash") @db.Char(64)
  iinEncrypted      Bytes         @map("iin_encrypted")
  phoneHash         String        @map("phone_hash") @db.Char(64)
  phoneEncrypted    Bytes         @map("phone_encrypted")
  fullName          String        @map("full_name") @db.VarChar(255)
  status            StudentStatus @default(unclaimed)
  guardianConsentAt DateTime?     @map("guardian_consent_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  awards     Award[]
  shareLinks ShareLink[]

  // Plus a partial UNIQUE index in migration.sql: one claimed account per phone.
  @@index([phoneHash])
  @@map("students")
}

// ---------- Events and awards ----------

model Event {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String     @db.VarChar(255)
  eventDate      DateTime   @map("event_date") @db.Date
  level          EventLevel
  subject        String     @db.VarChar(100)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  awards       Award[]

  // Target of the composite foreign key from awards (organization_id, event_id).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("events")
}

// organization_id is copied from the event and locked to it by the composite foreign key
// (organization_id, event_id) -> events (organization_id, id), so it can never disagree
// with the event. It lets the database enforce UC-2 A2: a document number is unique
// within one organization.
model Award {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  place          Int?        @db.SmallInt
  type           AwardType
  documentNumber String      @map("document_number") @db.VarChar(100)
  status         AwardStatus @default(active)
  createdBy      String      @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event          Event            @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  author         User             @relation("AwardCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  changeRequests ChangeRequest[]
  shareLinks     ShareLinkAward[]
  aiFlags        AiFlag[]
  aiJobs         AiJob[]

  @@unique([organizationId, documentNumber])
  @@index([eventId])
  @@index([studentId])
  @@index([documentNumber])
  @@index([createdBy])
  @@map("awards")
}

model ChangeRequest {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  awardId       String              @map("award_id") @db.Uuid
  requestedBy   String              @map("requested_by") @db.Uuid
  type          ChangeRequestType
  payload       Json?
  reason        String
  status        ChangeRequestStatus @default(pending)
  reviewedBy    String?             @map("reviewed_by") @db.Uuid
  reviewComment String?             @map("review_comment")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt    DateTime?           @map("reviewed_at") @db.Timestamptz(6)

  award     Award @relation(fields: [awardId], references: [id], onDelete: Restrict)
  requester User  @relation("ChangeRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer  User? @relation("ChangeReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([awardId])
  @@index([requestedBy])
  @@index([reviewedBy])
  @@index([status, createdAt])
  @@map("change_requests")
}

// ---------- Sharing ----------

model ShareLink {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  awards  ShareLinkAward[]

  @@index([studentId])
  @@map("share_links")
}

// Junction table: resolves the N:M relation between share_links and awards.
model ShareLinkAward {
  shareLinkId String @map("share_link_id") @db.Uuid
  awardId     String @map("award_id") @db.Uuid

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  award     Award     @relation(fields: [awardId], references: [id], onDelete: Restrict)

  @@id([shareLinkId, awardId])
  @@index([awardId])
  @@map("share_link_awards")
}

// ---------- System tables ----------

// One row per SMS code. No FK: during registration the user does not exist yet.
// payload_encrypted holds the pending registration (IIN, phone, full name, password hash,
// guardian consent) encrypted with AES-GCM until the code is verified (UC-1 steps 5-7).
model OtpCode {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneHash        String    @map("phone_hash") @db.Char(64)
  iinHash          String?   @map("iin_hash") @db.Char(64)
  codeHash         String    @map("code_hash") @db.VarChar(255)
  payloadEncrypted Bytes?    @map("payload_encrypted")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts         Int       @default(0) @db.SmallInt
  status           OtpStatus @default(issued)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt])
  @@map("otp_codes")
}

// Append-only: a trigger in migration.sql rejects UPDATE and DELETE.
// entity_id is polymorphic (points to rows of different tables), so it has no FK.
model AuditLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.Uuid
  action    String   @db.VarChar(50)
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId])
  @@map("audit_log")
}

model AiFlag {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  awardId    String       @map("award_id") @db.Uuid
  score      Decimal      @db.Decimal(4, 3)
  reasons    Json
  model      String?      @db.VarChar(100)
  status     AiFlagStatus @default(open)
  reviewedBy String?      @map("reviewed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  award    Award @relation(fields: [awardId], references: [id], onDelete: Restrict)
  reviewer User? @relation("AiFlagReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([awardId])
  @@index([status, createdAt])
  @@index([reviewedBy])
  @@map("ai_flags")
}

// One row per review run. An award can be reviewed again after a correction.
// run_after implements retry with exponential backoff (UC-5 A1): the worker
// takes queued jobs whose run_after has passed.
model AiJob {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  awardId    String      @map("award_id") @db.Uuid
  status     AiJobStatus @default(queued)
  attempts   Int         @default(0) @db.SmallInt
  lastError  String?     @map("last_error")
  runAfter   DateTime    @default(now()) @map("run_after") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(6)

  award Award @relation(fields: [awardId], references: [id], onDelete: Restrict)

  @@index([awardId])
  @@index([status, runAfter])
  @@map("ai_jobs")
}
